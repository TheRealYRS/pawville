# Copy to .env.local and fill in from Supabase → Connect (or Settings → API Keys).
# ONLY public browser keys go here — everything prefixed with VITE_ is shipped to the browser.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Preferred: the publishable key (starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy alternative (older projects): the "anon" key (a long JWT starting with eyJ).
# Only needed if you don't set VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=

# NEVER put the secret (sb_secret_...) or service_role key here or in Vercel/Netlify env vars.
# The app refuses to start if a secret key is detected in the browser bundle.
